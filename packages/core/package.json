{
  "name": "@ascii-graphs/core",
  "version": "0.1.0-alpha.0",
  "description": "Target-neutral layout engine for portable ASCII charts",
  "keywords": [
    "ascii",
    "charts",
    "graphs",
    "terminal",
    "cli",
    "email",
    "unicode"
  ],
  "author": "Juan Víctor Izquierdo",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  }
}
