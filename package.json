{
  "name": "ascii-graphs-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example:cli": "pnpm build && node examples/cli.mjs",
    "example:html:build": "tsup examples/browser.ts --format iife --platform browser --global-name AsciiGraphsGallery --out-dir examples/generated --clean",
    "example:html": "pnpm example:html:build && node examples/serve.mjs",
    "check:examples": "pnpm example:html:build && node examples/cli.mjs --help",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:examples"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
